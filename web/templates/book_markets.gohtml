{{define "private_content"}}
<header class="private-page-heading">
  <div><p class="private-kicker">Open board</p><h1>Markets</h1></div>
  <p>Place a wager on any open selection. Wagers stay pending until an admin accepts them at the odds shown.</p>
</header>

{{if .FormError}}<p class="betting-form-error" role="alert">{{.FormError}}</p>{{end}}

{{if .HasParlayableMarkets}}
<aside class="parlay-builder" aria-labelledby="parlay-slip-heading">
  <div class="parlay-builder-head">
    <h2 id="parlay-slip-heading">Parlay slip</h2>
    <p>Tick two or more match results. One losing leg loses the bet; a voided leg drops out and the rest reprice.</p>
  </div>
  <label class="parlay-stake-field" for="parlay-stake">
    <span>Stake</span>
    <input id="parlay-stake" name="parlay_stake" inputmode="decimal" autocomplete="off" placeholder="0.00"
           hx-post="/book/parlays/quote" hx-trigger="keyup changed delay:400ms, change"
           hx-target="#parlay-slip-body" hx-swap="innerHTML"
           hx-include="[name='leg']:checked, [name='parlay_stake'], [name='csrf_token']">
  </label>
  {{/* Only this region swaps, so the stake field above keeps focus while it
       is being typed into. */}}
  <div id="parlay-slip-body">
    <p class="parlay-empty">Pick at least two matches to build a parlay.</p>
  </div>
  <form method="post" action="/book/parlays" class="parlay-place-form"
        hx-post="/book/parlays" hx-target="this" hx-swap="outerHTML"
        hx-include="[name='leg']:checked, [name='parlay_stake']">
    <input type="hidden" name="csrf_token" value="{{.Session.CSRFToken}}">
    <input type="hidden" name="idempotency_key" value="{{.ParlayPlaceKey}}">
    <button type="submit">Place parlay for review</button>
  </form>
</aside>
{{end}}

{{range .Markets}}
<section class="betting-market-card" aria-label="{{.Market.Title}}">
  <div class="betting-market-head">
    <h2>{{.Market.Title}}</h2>
    <p class="betting-market-meta">
      <span class="private-status">{{.Market.Type}}</span>
      Closes {{when .Market.ClosesAt}} &middot; {{.Market.Currency}}
      {{if .Market.MaxStakeCents}}&middot; <strong>Max {{dollars .Market.MaxStakeCents}} each</strong>{{end}}
    </p>
  </div>
  <div class="private-table-wrap">
    <table class="private-table private-table-stack">
      <thead><tr><th scope="col">Selection</th><th scope="col">Odds</th><th scope="col">Place a wager</th></tr></thead>
      <tbody>
        {{range .Selections}}
        <tr>
          <th scope="row">
            {{.DisplayTerms}}
            {{/* Only match results can be parlayed: a prop or future can be
                 entangled with a match, and the book cannot price correlation. */}}
            {{if .Parlayable}}
            <label class="parlay-pick">
              <input type="checkbox" name="leg" value="{{.MarketID}}:{{.ID}}"
                     hx-post="/book/parlays/quote" hx-trigger="change"
                     hx-target="#parlay-slip-body" hx-swap="innerHTML"
                     hx-include="[name='leg']:checked, [name='parlay_stake'], [name='csrf_token']">
              <span>Add to parlay</span>
            </label>
            {{end}}
          </th>
          <td class="private-odds" data-label="Odds">{{odds .OfferedAmericanOdds}}{{if .MaxStakeCents}}<small class="betting-side-limit">max {{dollars .MaxStakeCents}}</small>{{end}}</td>
          <td class="is-stack-block" data-label="Place a wager">
            <form method="post" action="/book/wagers" class="betting-place-form" hx-post="/book/wagers" hx-target="this" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
              <input type="hidden" name="market_id" value="{{.MarketID}}">
              <input type="hidden" name="selection_id" value="{{.ID}}">
              <input type="hidden" name="idempotency_key" value="{{.PlaceKey}}">
              <label class="visually-hidden" for="stake-{{.ID}}">Stake for {{.DisplayTerms}}</label>
              <input id="stake-{{.ID}}" name="stake" inputmode="decimal" autocomplete="off" placeholder="0.00" required>
              <button type="submit">Place</button>
            </form>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="3" class="private-empty-cell">No selections are available.</td></tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>
{{else}}
<p class="private-empty">No markets are open right now. Check back once the book posts new lines.</p>
{{end}}
{{end}}
