{{define "private_content"}}
<header class="private-page-heading">
  <div><p class="private-kicker">Book administration</p><h1>Markets</h1></div>
  <p><a class="betting-primary-link" href="/admin/markets/new">Create a market</a> &middot; <a href="/admin/wagers">Review pending wagers</a></p>
</header>

<section aria-labelledby="admin-markets-heading">
  <h2 id="admin-markets-heading" class="visually-hidden">All markets</h2>
  <div class="private-table-wrap">
    <table class="private-table private-table-wide">
      <thead><tr><th scope="col">Market</th><th scope="col">Type</th><th scope="col">State</th><th scope="col">Currency</th><th scope="col">Closes</th><th scope="col">Selections</th><th scope="col">Actions</th></tr></thead>
      <tbody>
        {{range .Markets}}
        <tr>
          <th scope="row">{{.Market.Title}}{{if .Market.DynamicPricing}} <span class="betting-pricing-badge" title="Line moves automatically as action comes in">auto-priced</span>{{end}}</th>
          <td><span class="private-status">{{.Market.Type}}</span></td>
          <td><span class="private-status">{{.Market.State}}</span></td>
          <td>{{.Market.Currency}}</td>
          <td>{{when .Market.ClosesAt}}
            {{if or (eq .Market.State "open") (eq .Market.State "draft")}}
            <form method="post" action="/admin/markets/{{.Market.ID}}/close-time" class="betting-inline-form betting-close-time-form" hx-post="/admin/markets/{{.Market.ID}}/close-time" hx-target="this" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
              <label class="visually-hidden" for="closes-{{.Market.ID}}">New closing time</label>
              <input type="datetime-local" id="closes-{{.Market.ID}}" name="closes_at" required>
              <label class="visually-hidden" for="closes-reason-{{.Market.ID}}">Why the closing time is moving</label>
              <input id="closes-reason-{{.Market.ID}}" name="reason" maxlength="500" placeholder="Why" required>
              <button type="submit">Move</button>
            </form>
            {{end}}
          </td>
          <td>
            {{$market := .Market}}
            {{range .Selections}}
            <div class="betting-selection-line">
              <span class="betting-selection-chip">{{.DisplayTerms}} <span class="private-odds">{{odds .OfferedAmericanOdds}}</span>{{if .Moved}} <span class="betting-line-moved" title="Opened at {{odds .OpeningAmericanOdds}}">(from {{odds .OpeningAmericanOdds}})</span>{{end}}</span>
              {{if or (eq $market.State "open") (eq $market.State "draft")}}
              <form method="post" action="/admin/markets/{{$market.ID}}/selections/{{.ID}}/line" class="betting-inline-form betting-set-line-form" hx-post="/admin/markets/{{$market.ID}}/selections/{{.ID}}/line" hx-target="this" hx-swap="outerHTML">
                <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
                <label class="visually-hidden" for="line-{{.ID}}">New line for {{.DisplayTerms}}</label>
                <input id="line-{{.ID}}" name="odds" value="{{odds .OpeningAmericanOdds}}" inputmode="numeric" size="6" required>
                <label class="visually-hidden" for="line-reason-{{.ID}}">Why the line is being moved</label>
                <input id="line-reason-{{.ID}}" name="reason" maxlength="500" placeholder="Why" required>
                <button type="submit">Set line</button>
              </form>
              {{end}}
            </div>
            {{end}}
          </td>
          <td class="betting-actions-cell">
            {{if eq .Market.State "draft"}}
            <form method="post" action="/admin/markets/{{.Market.ID}}/open" class="betting-inline-form" hx-post="/admin/markets/{{.Market.ID}}/open" hx-target="this" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
              <button type="submit">Open</button>
            </form>
            {{end}}
            {{if eq .Market.State "open"}}
            <form method="post" action="/admin/markets/{{.Market.ID}}/close" class="betting-inline-form" hx-post="/admin/markets/{{.Market.ID}}/close" hx-target="this" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
              <button type="submit">Close</button>
            </form>
            {{end}}
            {{if or (eq .Market.State "open") (eq .Market.State "closed") (eq .Market.State "settlement_pending")}}
            <a class="betting-action-link" href="/admin/markets/{{.Market.ID}}/settle">Settle / void</a>
            {{end}}
            {{if or (eq .Market.State "open") (eq .Market.State "draft")}}
            <details class="betting-restrict">
              <summary>Restrict a member</summary>
              <form method="post" action="/admin/markets/{{.Market.ID}}/restrict" class="betting-inline-form betting-restrict-form" hx-post="/admin/markets/{{.Market.ID}}/restrict" hx-target="this" hx-swap="outerHTML">
                <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
                <label class="visually-hidden" for="restrict-member-{{.Market.ID}}">Member</label>
                <select id="restrict-member-{{.Market.ID}}" name="user_id" required>
                  <option value="">Choose a member</option>
                  {{range $.Members}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
                </select>
                <label class="visually-hidden" for="restrict-outcome-{{.Market.ID}}">Outcome</label>
                <select id="restrict-outcome-{{.Market.ID}}" name="selection_id">
                  <option value="">The whole market</option>
                  {{range .Selections}}<option value="{{.ID}}">{{.DisplayTerms}} only</option>{{end}}
                </select>
                <label class="visually-hidden" for="restrict-reason-{{.Market.ID}}">Reason</label>
                <input id="restrict-reason-{{.Market.ID}}" name="reason" maxlength="500" placeholder="Why" required>
                <button type="submit" class="betting-danger-button">Restrict</button>
              </form>
            </details>
            {{end}}
          </td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="private-empty-cell">No markets exist yet.</td></tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>

<section aria-labelledby="restrictions-heading">
  <div class="private-section-heading"><h2 id="restrictions-heading">Restricted members</h2></div>
  <p class="pulse-note">A restricted member does not see the market, or the side, at all — and a wager on it is refused even if they go looking for it. Use it when the bet is about them.</p>
  <div class="private-table-wrap">
    <table class="private-table private-table-wide private-table-stack">
      <thead><tr><th scope="col">Member</th><th scope="col">Market</th><th scope="col">Restricted from</th><th scope="col">Reason</th><th scope="col">By</th><th scope="col">Actions</th></tr></thead>
      <tbody>
        {{range .Restrictions}}
        <tr>
          <th scope="row">{{.MemberName}}</th>
          <td data-label="Market">{{.MarketTitle}}</td>
          <td data-label="Restricted from">{{if .WholeMarket}}The whole market{{else}}{{.SelectionTerms}}{{end}}</td>
          <td data-label="Reason">{{.Reason}}</td>
          <td data-label="By">{{.RestrictedBy}}</td>
          <td class="betting-actions-cell is-stack-block" data-label="Actions">
            <form method="post" action="/admin/markets/{{.MarketID}}/restrict/lift" class="betting-inline-form" hx-post="/admin/markets/{{.MarketID}}/restrict/lift" hx-target="this" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="selection_id" value="{{.SelectionID}}">
              <button type="submit">Lift</button>
            </form>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="private-empty-cell">Nobody is restricted from any live market.</td></tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>
{{end}}
