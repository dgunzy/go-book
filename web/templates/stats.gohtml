{{define "content"}}
<header class="page-header section-shell">
  <p class="eyebrow dark">The record book</p>
  <h1>Statistics</h1>
  <p>One career record across every cup, with the archive and the verified match record kept separately auditable beneath it.</p>
</header>

{{if .Career}}
<section class="section-shell leaderboard combined-career" aria-labelledby="career">
  <div class="leaderboard-heading">
    <div>
      <p class="eyebrow dark">Career record{{if .CareerTo}} &middot; {{.CareerFrom}}&ndash;{{.CareerTo}}{{end}}</p>
      <h2 id="career">Every cup, one table</h2>
    </div>
    <p>The archive through {{.CareerFrom}}&ndash;2024 plus every verified match since, added together. A tie counts as half a win. Players under {{.QualifyingLimit}} career matches are listed but not ranked.</p>
  </div>
  <div class="wide-table-wrap" tabindex="0" role="region" aria-label="Career record table">
    <table class="wide-table career-table">
      <thead>
        <tr>
          <th scope="col">Rank</th><th scope="col">Player</th>
          <th scope="col">Played</th><th scope="col">Wins</th><th scope="col">Losses</th><th scope="col">Ties</th>
          <th scope="col">Points won</th><th scope="col">Cup record</th><th scope="col">Record from</th>
        </tr>
      </thead>
      <tbody>
        {{range $index, $player := .Career}}
        <tr{{if not $player.Qualified}} class="career-unranked"{{end}}>
          <td class="rank">{{if $player.Qualified}}{{add1 $index}}{{else}}&mdash;{{end}}</td>
          <th scope="row"><a href="/players#{{$player.Slug}}">{{$player.Name}}</a></th>
          <td>{{$player.Played}}</td><td>{{$player.Wins}}</td><td>{{$player.Losses}}</td><td>{{$player.Ties}}</td>
          <td><strong>{{$player.PointsPercent}}%</strong></td>
          <td>{{if $player.HasLegacy}}{{$player.CupWins}}&ndash;{{$player.CupLosses}}{{else}}&mdash;{{end}}</td>
          <td><small>{{$player.Sources}}</small></td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <p class="table-hint">Cup record counts team wins and losses from the archive only, so it stops at 2024 until earlier cups are entered as verified matches.</p>
</section>
{{end}}

{{if .VerifiedCareer}}
<section class="section-shell leaderboard authoritative-career" aria-labelledby="verified-career">
  <div class="leaderboard-heading">
    <div>
      <p class="eyebrow dark">Authoritative record{{if .VerifiedSeasons}} &middot; {{with index .VerifiedSeasons 0}}{{.Year}}{{end}} onward{{end}}</p>
      <h2 id="verified-career">Verified match record</h2>
    </div>
    <p>Built match by match from confirmed results, so it currently covers only the cups entered as verified matches. Singles and team-format records stay separately auditable.</p>
  </div>
  <div class="wide-table-wrap">
    <table class="wide-table verified-stats-table">
      <thead><tr><th>Player</th><th colspan="5">Overall</th><th colspan="5">Singles</th><th colspan="5">Team formats</th></tr><tr><th></th><th>P</th><th>W</th><th>L</th><th>T</th><th>Pts</th><th>P</th><th>W</th><th>L</th><th>T</th><th>Pts</th><th>P</th><th>W</th><th>L</th><th>T</th><th>Pts</th></tr></thead>
      <tbody>{{range .VerifiedCareer}}<tr><th scope="row">{{.PlayerName}}</th><td>{{.Played}}</td><td>{{.Wins}}</td><td>{{.Losses}}</td><td>{{.Ties}}</td><td><strong>{{.Points}}</strong></td><td>{{.SinglesPlayed}}</td><td>{{.SinglesWins}}</td><td>{{.SinglesLosses}}</td><td>{{.SinglesTies}}</td><td>{{.SinglesPoints}}</td><td>{{.TeamPlayed}}</td><td>{{.TeamWins}}</td><td>{{.TeamLosses}}</td><td>{{.TeamTies}}</td><td>{{.TeamPoints}}</td></tr>{{end}}</tbody>
    </table>
  </div>
  <nav class="verified-season-links" aria-label="Verified season statistics"><strong>Season records:</strong>{{range .VerifiedSeasons}} <a href="/history/{{.Year}}">{{.Year}}</a>{{end}}</nav>
</section>
{{end}}

<section class="stat-strip section-shell" aria-label="Dataset summary">
  <div><span>Players</span><strong>{{.TotalPlayers}}</strong></div>
  <div><span>Cup appearances</span><strong>{{.CupAppearances}}</strong></div>
  <div><span>Player-match entries</span><strong>{{.MatchEntries}}</strong></div>
  {{with .Leader}}<div><span>Archive leader &middot; {{$.QualifyingLimit}}+ matches</span><strong>{{.Name}} &middot; {{.WinningPercentage}}%</strong></div>{{end}}
</section>

<aside class="section-shell archive-note compact" aria-label="Data source note">
  <strong>{{.SnapshotLabel}}</strong>
  <p>Player-match entries count both participants in a match and cannot be converted into verified match events. {{.SnapshotNote}}</p>
</aside>

<section class="section-shell leaderboard">
  <div class="leaderboard-heading">
    <div>
      <p class="eyebrow dark">Legacy snapshot &middot; through 2024</p>
      <h2>Historical aggregate record</h2>
    </div>
    <p>The archive exactly as it was imported, with no verified matches folded in. Ties count as half a win, matching the legacy site's calculation.</p>
  </div>
  <div class="wide-table-wrap" tabindex="0" role="region" aria-label="Historical aggregate record table">
    <table class="wide-table">
      <thead>
        <tr><th scope="col">Rank</th><th scope="col">Player</th><th scope="col">Played</th><th scope="col">Wins</th><th scope="col">Losses</th><th scope="col">Ties</th><th scope="col">Points won</th><th scope="col">Cup record</th></tr>
      </thead>
      <tbody>
        {{range $index, $player := .Players}}
        <tr>
          <td class="rank">{{add1 $index}}</td>
          <th scope="row"><a href="/players#{{$player.Slug}}">{{$player.Name}}</a></th>
          <td>{{$player.MatchesPlayed}}</td><td>{{$player.MatchWins}}</td><td>{{$player.MatchLosses}}</td><td>{{$player.MatchTies}}</td>
          <td><strong>{{$player.WinningPercentage}}%</strong></td><td>{{$player.TeamWins}}&ndash;{{$player.TeamLosses}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>
{{end}}
