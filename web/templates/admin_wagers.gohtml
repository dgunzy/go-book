{{define "private_content"}}
<header class="private-page-heading">
  <div><p class="private-kicker">Book administration</p><h1>Pending wagers</h1></div>
  <p>Accepting a wager moves the member's stake into escrow at the recorded odds. <a href="/admin/markets">Manage markets</a>.</p>
</header>

{{$stale := 0}}{{range .AdminWagers}}{{if .MovedToMember}}{{$stale = 1}}{{end}}{{end}}
{{if $stale}}
<div class="betting-line-alert" role="status">
  <strong>Line moved in a member's favour</strong>
  <p>One or more pending wagers are locked at a price that pays the member more than the board does now. They still fill at the locked price if you accept them — reject if you do not want to take the stale number.</p>
</div>
{{end}}

<section aria-labelledby="pending-wagers-heading">
  <h2 id="pending-wagers-heading" class="visually-hidden">Pending wagers</h2>
  <div class="private-table-wrap">
    <table class="private-table private-table-wide private-table-stack">
      <thead><tr><th scope="col">Placed</th><th scope="col">Member</th><th scope="col">Market</th><th scope="col">Selection</th><th scope="col">Odds</th><th scope="col">Live line</th><th scope="col">Stake</th><th scope="col">To win</th><th scope="col">Actions</th></tr></thead>
      <tbody>
        {{range .AdminWagers}}
        <tr{{if .MovedToMember}} class="is-line-moved"{{end}}>
          <td data-label="Placed">{{when .PlacedAt}}</td>
          <th scope="row">{{.UserDisplayName}}</th>
          <td data-label="Market">{{.MarketTitle}}</td>
          <td data-label="Selection">{{.SelectionTerms}}</td>
          <td class="private-odds" data-label="Odds">{{odds .Odds}}</td>
          <td class="private-odds betting-line-cell is-stack-block" data-label="Live line">
            {{if .LiveLineAvailable}}
              <span class="betting-line-price">{{odds .CurrentOdds}}</span>
              {{if .MovedToMember}}
                <span class="betting-line-flag is-warning">Moved in member's favour</span>
                <small>Would win {{money .LiveProfit}} at today's line — {{money .ProfitDelta}} against the locked price.</small>
              {{else if .MovedToBook}}
                <span class="betting-line-flag is-ok">Moved to the book</span>
                <small class="betting-line-note">Would win {{money .LiveProfit}} at today's line.</small>
              {{else}}
                <span class="betting-line-flag">Unchanged</span>
              {{end}}
            {{else}}
              <span class="betting-line-flag">Off the board</span>
            {{end}}
          </td>
          <td class="private-money" data-label="Stake">{{money .Stake}}</td>
          <td class="private-money" data-label="To win">{{money .PotentialProfit}}</td>
          <td class="betting-actions-cell is-stack-block" data-label="Actions">
            <form method="post" action="/admin/wagers/{{.ID}}/accept" class="betting-inline-form" hx-post="/admin/wagers/{{.ID}}/accept" hx-target="this" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
              <button type="submit">Accept</button>
            </form>
            <form method="post" action="/admin/wagers/{{.ID}}/reject" class="betting-inline-form" hx-post="/admin/wagers/{{.ID}}/reject" hx-target="this" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value="{{$.Session.CSRFToken}}">
              <label class="visually-hidden" for="reject-reason-{{.ID}}">Rejection reason</label>
              <input id="reject-reason-{{.ID}}" name="reason" maxlength="500" placeholder="Reason" required>
              <button type="submit" class="betting-danger-button">Reject</button>
            </form>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="9" class="private-empty-cell">No wagers are waiting for review.</td></tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>
{{end}}
