{{define "private_content"}}
<header class="private-page-heading">
  <div><p class="private-kicker">Book administration</p><h1>Dashboard</h1></div>
  <p>How the book is doing, what is still at risk, and who is running hot. Snapshot as of {{when .Pulse.AsOf}} · CAD.</p>
</header>

<nav class="private-tabs" aria-label="Dashboard views" data-dashboard-tabs>
  <a href="#overview" data-tab="overview" aria-current="page">Overview</a>
  <a href="#exposure" data-tab="exposure">Exposure</a>
  <a href="#players" data-tab="players">Players</a>
  <a href="#action" data-tab="action">Action</a>
  <a href="#health" data-tab="health">Ledger health</a>
</nav>

<div class="dashboard-panel" data-panel="overview">
<section class="pulse-hero" aria-labelledby="house-result-heading">
  <div class="pulse-hero-figure {{if lt .Pulse.HouseResult.Cents 0}}is-down{{else}}is-up{{end}}">
    <span id="house-result-heading">House result</span>
    <strong>{{money .Pulse.HouseResult}}</strong>
    <small>{{if lt .Pulse.HouseResult.Cents 0}}The book is behind on settled action.{{else}}Banked from settled action.{{end}}</small>
  </div>
  <dl class="pulse-hero-stats">
    <div><dt>In escrow</dt><dd>{{money .Pulse.Escrow}}</dd><span>Stake held on live bets</span></div>
    <div><dt>Handle</dt><dd>{{money .Pulse.Handle}}</dd><span>Total action taken</span></div>
    <div><dt>Open markets</dt><dd>{{.Pulse.OpenMarkets}}</dd><span>Taking bets now</span></div>
  </dl>
</section>

<section aria-labelledby="swing-heading">
  <div class="private-section-heading"><h2 id="swing-heading">If everything lands</h2></div>
  <div class="pulse-swing">
    <article class="is-worst">
      <span>Worst case</span>
      <strong>{{money .Pulse.WorstCase}}</strong>
      <small>Every unsettled market lands on the side that hurts the book most.</small>
    </article>
    <article class="is-best">
      <span>Best case</span>
      <strong>{{money .Pulse.BestCase}}</strong>
      <small>Every unsettled market lands the book's way.</small>
    </article>
    <article>
      <span>Waiting on you</span>
      <strong>{{.Pulse.PendingWagers}}</strong>
      <small>{{money .Pulse.PendingStake}} pending. <a href="/admin/wagers">Review wagers</a>.</small>
    </article>
    <article>
      <span>Live bets</span>
      <strong>{{.Pulse.OpenWagerCount}}</strong>
      <small>Accepted and waiting on a result.</small>
    </article>
  </div>
</section>

</div>

<div class="dashboard-panel" data-panel="exposure">
<section aria-labelledby="exposure-heading">
  <div class="private-section-heading"><h2 id="exposure-heading">Exposure by market</h2></div>
  <p class="pulse-note">What the house nets on each outcome: every stake in the market less what that side would be paid. The row that costs the book most is marked.</p>
  <div class="private-table-wrap">
    <table class="private-table private-table-wide private-table-stack">
      <thead><tr><th scope="col">Market</th><th scope="col">Outcome</th><th scope="col">Bets</th><th scope="col">Stake on it</th><th scope="col">Pays out</th><th scope="col">House nets</th></tr></thead>
      <tbody>
        {{range .Pulse.Exposure}}
        {{$market := .}}
        {{range $index, $outcome := .Outcomes}}
        <tr{{if $outcome.Worst}} class="is-worst-outcome"{{end}}>
          {{if eq $index 0}}
          <th scope="row" rowspan="{{len $market.Outcomes}}" class="is-stack-hidden">{{$market.Market}}<small>{{$market.State}} · closes {{when $market.ClosesAt}} · {{money $market.Stake}} in</small></th>
          {{end}}
          <td class="is-stack-block" data-label="Outcome">{{$outcome.Selection}}<small class="is-stack-only">{{$market.Market}}</small></td>
          <td data-label="Bets">{{$outcome.Wagers}}</td>
          <td class="private-money" data-label="Stake on it">{{money $outcome.Stake}}</td>
          <td class="private-money" data-label="Pays out">{{money $outcome.Payout}}</td>
          <td class="private-money{{if lt $outcome.HouseNet.Cents 0}} is-behind-text{{end}}" data-label="House nets">{{money $outcome.HouseNet}}</td>
        </tr>
        {{end}}
        {{else}}
        <tr><td colspan="6" class="private-empty-cell">No market is carrying risk right now.</td></tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>

</div>

<div class="dashboard-panel" data-panel="players">
<section aria-labelledby="standings-heading">
  <div class="private-section-heading"><h2 id="standings-heading">Player standings</h2></div>
  <p class="pulse-note">Each member's realized profit or loss against the book, straight from the ledger. Live bets do not count until they settle.</p>
  {{if .Pulse.Players}}
  <figure class="pulse-chart">
    <figcaption>
      <span class="pulse-key"><i class="pulse-swatch is-ahead"></i>Ahead of the book</span>
      <span class="pulse-key"><i class="pulse-swatch is-behind"></i>Behind the book</span>
      <span class="pulse-key-scale">Longest bar = {{money .Pulse.PlayerScale}}</span>
    </figcaption>
    <div class="private-table-wrap">
      <table class="private-table pulse-standings private-table-stack">
        <thead><tr><th scope="col">Player</th><th scope="col">Net</th><th scope="col">Ahead / behind</th><th scope="col">Record</th><th scope="col">Live</th><th scope="col">Handle</th></tr></thead>
        <tbody>
          {{range .Pulse.Players}}
          <tr>
            <th scope="row">{{if .UserID}}<a class="betting-primary-link" href="/admin/members/{{.UserID}}/book">{{.Name}}</a>{{else}}{{.Name}}{{end}}</th>
            <td class="private-money{{if .Ahead}} is-ahead-text{{else if lt .Net.Cents 0}} is-behind-text{{end}}" data-label="Net">{{money .Net}}</td>
            <td class="pulse-plot" data-label="Ahead / behind">
              {{/* Bar geometry is SVG attributes, never an inline style: the
                   page's Content-Security-Policy sets style-src 'self', so a
                   style attribute is dropped by the browser and the bar
                   collapses to nothing. */}}
              <svg class="pulse-plot-svg" viewBox="0 0 200 22" preserveAspectRatio="none" role="img"
                   aria-label="{{.Name}}: {{money .Net}} {{if .Ahead}}ahead of{{else if lt .Net.Cents 0}}behind{{else}}level with{{end}} the book">
                <rect class="pulse-svg-track" x="0" y="3" width="200" height="16"></rect>
                {{if .BarWidth}}<rect class="pulse-svg-bar {{if .Ahead}}is-ahead{{else}}is-behind{{end}}" x="{{.BarX}}" y="3" width="{{.BarWidth}}" height="16"></rect>{{end}}
                <rect class="pulse-svg-zero" x="99.5" y="0" width="1" height="22"></rect>
              </svg>
            </td>
            <td data-label="Record">{{.Won}}&ndash;{{.Lost}}{{if .Pushed}} <small>({{.Pushed}} push)</small>{{end}}</td>
            <td data-label="Live">{{.Open}}</td>
            <td class="private-money" data-label="Handle">{{money .Handle}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
  </figure>
  {{else}}
  <p class="private-empty">Nobody has action yet. Once wagers settle, the standings show up here.</p>
  {{end}}
</section>

<section aria-labelledby="outstanding-heading">
  <div class="private-section-heading"><h2 id="outstanding-heading">Owed and owing</h2></div>
  <p class="pulse-note">Cash positions, not results: what each member still owes the book or is still owed by it. Settling up on the <a href="/admin/settle-up">Settle up</a> page moves these and leaves the standings above untouched.</p>
  <div class="pulse-swing pulse-owed">
    <article class="is-best"><span>Owed to the book</span><strong>{{money .Pulse.OwedToBook}}</strong><small>Members who are down and have not paid yet.</small></article>
    <article class="is-worst"><span>Owed by the book</span><strong>{{money .Pulse.OwedByBook}}</strong><small>Winnings not yet paid out.</small></article>
  </div>
  {{if .Pulse.Outstanding}}
  <div class="private-table-wrap">
    <table class="private-table private-table-stack">
      <thead><tr><th scope="col">Member</th><th scope="col">Balance</th><th scope="col">Position</th></tr></thead>
      <tbody>
        {{range .Pulse.Outstanding}}
        <tr>
          <th scope="row">{{if .UserID}}<a class="betting-primary-link" href="/admin/members/{{.UserID}}/book">{{.Name}}</a>{{else}}{{.Name}}{{end}}</th>
          <td class="private-money{{if .Owes}} is-behind-text{{else}} is-ahead-text{{end}}" data-label="Balance">{{money .Balance}}</td>
          <td data-label="Position">{{if .Owes}}Owes the book{{else}}The book owes them{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="private-empty">Everyone is square with the book.</p>
  {{end}}
</section>

</div>

<div class="dashboard-panel" data-panel="action">
<section aria-labelledby="open-action-heading">
  <div class="private-section-heading"><h2 id="open-action-heading">Action on the board</h2></div>
  <p class="pulse-note">Every accepted bet still waiting on a result, newest first. Click a member to open their book.</p>
  <div class="table-filter" data-filter-for="open-action">
    <label for="open-action-filter">Filter</label>
    <input id="open-action-filter" type="search" placeholder="Member, market or pick — e.g. Nasrallah" autocomplete="off" data-filter-input>
    <span class="table-filter-count" data-filter-count></span>
  </div>
  <div class="private-table-wrap">
    <table class="private-table private-table-wide private-table-stack" id="open-action">
      <thead><tr><th scope="col">Placed</th><th scope="col">Member</th><th scope="col">Market</th><th scope="col">Selection</th><th scope="col">Odds</th><th scope="col">Stake</th><th scope="col">To win</th></tr></thead>
      <tbody>
        {{range .Pulse.OpenWagers}}
        <tr>
          <td data-label="Placed">{{when .PlacedAt}}</td>
          <th scope="row">{{if .MemberID}}<a class="betting-primary-link" href="/admin/members/{{.MemberID}}/book">{{.Member}}</a>{{else}}{{.Member}}{{end}}</th>
          <td data-label="Market">{{.Market}}</td>
          <td data-label="Selection">{{.Selection}}</td>
          <td class="private-odds" data-label="Odds">{{odds .Odds}}</td>
          <td class="private-money" data-label="Stake">{{money .Stake}}</td>
          <td class="private-money" data-label="To win">{{money .ToWin}}</td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="private-empty-cell">No bets are live right now.</td></tr>
        {{end}}
      </tbody>
    </table>
  </div>
</section>

</div>

<div class="dashboard-panel" data-panel="health">
<section class="reconciliation-state {{if .Reconciliation.LedgerBalanced}}is-clear{{else}}is-alert{{end}}" aria-labelledby="ledger-state-heading">
  <div>
    <span>Ledger state</span>
    <h2 id="ledger-state-heading">{{if .Reconciliation.LedgerBalanced}}Balanced{{else}}Review required{{end}}</h2>
  </div>
  <dl>
    <div><dt>Transactions checked</dt><dd>{{.Reconciliation.LedgerTransactions}}</dd></div>
    <div><dt>Unbalanced</dt><dd>{{.Reconciliation.UnbalancedTransactions}}</dd></div>
    <div><dt>Migration difference</dt><dd>{{money .Reconciliation.MigrationDifference}}</dd></div>
  </dl>
</section>

<section aria-labelledby="operations-heading">
  <div class="private-section-heading"><h2 id="operations-heading">Operational queues</h2></div>
  <div class="admin-metric-grid">
    <article><span>Pending outbox</span><strong>{{.Reconciliation.PendingOutboxEvents}}</strong></article>
    <article><span>Failed outbox</span><strong>{{.Reconciliation.FailedOutboxEvents}}</strong></article>
  </div>
</section>
</div>
{{end}}
